{
  "name": "inu-taikenki-cloudflare-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "tsc --noEmit",
    "cf-types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply inu-taikenki --local",
    "db:migrate:remote": "wrangler d1 migrations apply inu-taikenki --remote",
    "db:seed:local": "wrangler d1 execute inu-taikenki --local --file=./seed.sql",
    "db:seed:remote": "wrangler d1 execute inu-taikenki --remote --file=./seed.sql",
    "test": "node --test tests/api.test.mjs tests/static.test.mjs",
    "test:browser": "node --test tests/browser.test.mjs",
    "preview:check": "node scripts/preview.mjs check",
    "preview:publish": "node scripts/preview.mjs publish",
    "test:preview": "node --import ./tests/ts-loader.mjs --test tests/preview.test.mjs tests/readonly-db.test.mjs tests/static.test.mjs"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "wrangler": "4.135.0",
    "playwright": "^1.61.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
