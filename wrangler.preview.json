{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "inu-taikenki",
  "main": "src/preview-entry.ts",
  "compatibility_date": "2026-09-02",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": true
  },
  "previews": {
    "vars": { "APP_ENV": "preview" },
    "d1_databases": [{
      "binding": "DB",
      "database_name": "inu-taikenki-preview",
      "database_id": "REQUIRES_VERIFIED_PREVIEW_D1_ID"
    }]
  }
}
