{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "inu-taikenki",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-02",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true }
}
